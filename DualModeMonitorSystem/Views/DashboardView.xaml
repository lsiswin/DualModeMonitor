<UserControl
    x:Class="DualModeMonitorSystem.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DualModeMonitorSystem.Views"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vm="clr-namespace:DualModeMonitorSystem.ViewModels"
    d:DataContext="{d:DesignInstance vm:DashboardViewModel,
                                     IsDesignTimeCreatable=True}"
    mc:Ignorable="d">
    <ScrollViewer>

        <Grid Background="#1E222B">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ItemsControl ItemsSource="{Binding StatisticsResult}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <md:Card Margin="10" Background="#272E3B">
                            <DockPanel>
                                <StackPanel Margin="10">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="ExtraLight"
                                        Foreground="#C0C0C0"
                                        Text="{Binding Title}" />
                                    <TextBlock
                                        Margin="0,10"
                                        FontSize="23"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding Value}" />
                                </StackPanel>
                                <md:PackIcon
                                    Width="50"
                                    Height="50"
                                    Margin="0,20,10,0"
                                    HorizontalAlignment="Right"
                                    Foreground="BlueViolet"
                                    Kind="{Binding Icon}" />
                            </DockPanel>
                        </md:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="10"
                    Padding="5"
                    Background="#272E3B"
                    CornerRadius="5">
                    <StackPanel Margin="10">
                        <DockPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="实时监控数据" />
                            <Border
                                Padding="5"
                                HorizontalAlignment="Right"
                                Background="#374151"
                                CornerRadius="3">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="#2063DF"
                                    Text="最后更新: 10:24:35" />
                            </Border>
                        </DockPanel>
                        <TextBlock
                            Margin="0,20,0,5"
                            FontSize="13"
                            Foreground="#C0C0C0"
                            Text="选择设备" />
                        <Border Background="#1E222B">
                            <ComboBox
                                Padding="6"
                                md:HintAssist.Hint="设备#1 (车间A-1区)"
                                Foreground="White" />
                        </Border>
                        <StackPanel Margin="0,10">
                            <!--  温度监控卡片  -->
                            <md:Card
                                Margin="0,5"
                                Padding="12"
                                Background="#1E222B"
                                Foreground="#C0C0C0">
                                <StackPanel>
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock Style="{DynamicResource mdBodyTextBlock}" Text="当前温度" />
                                        <md:Card
                                            HorizontalAlignment="Right"
                                            Background="{DynamicResource MaterialDesignColor.Blue400}"
                                            Content="正常" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="25"
                                            FontWeight="DemiBold"
                                            Foreground="White"
                                            Style="{DynamicResource MaterialDesignHeadlineTextBlock}"
                                            Text="23.5 °C" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="Green"
                                            Style="{DynamicResource MaterialDesignBody2TextBlock}"
                                            Text="0.2°C" />
                                    </Grid>

                                    <ProgressBar
                                        Foreground="{DynamicResource MaterialDesignColor.Blue400}"
                                        Style="{DynamicResource MaterialDesignLinearProgressBar}"
                                        Value="45" />
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="0°C" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="阈值: 30°C" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="50°C" />
                                    </Grid>
                                </StackPanel>
                            </md:Card>
                            <!--  湿度监控卡片  -->
                            <md:Card
                                Margin="0,5"
                                Padding="12"
                                Background="#1E222B"
                                Foreground="#C0C0C0">
                                <StackPanel>
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock Style="{DynamicResource mdBodyTextBlock}" Text="当前湿度" />
                                        <md:Card
                                            HorizontalAlignment="Right"
                                            Background="{DynamicResource MaterialDesignColor.Blue400}"
                                            Content="正常" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="25"
                                            FontWeight="DemiBold"
                                            Foreground="White"
                                            Style="{DynamicResource MaterialDesignHeadlineTextBlock}"
                                            Text="45.2%" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="Green"
                                            Style="{DynamicResource MaterialDesignBody2TextBlock}"
                                            Text="1.3%" />
                                    </Grid>

                                    <ProgressBar
                                        Foreground="{DynamicResource MaterialDesignColor.Blue400}"
                                        Style="{DynamicResource MaterialDesignLinearProgressBar}"
                                        Value="45" />
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="0%" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="阈值: 60%" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="100%" />
                                    </Grid>
                                </StackPanel>
                            </md:Card>

                            <!--  设备电压监控卡片  -->
                            <md:Card
                                Margin="0,5"
                                Padding="12"
                                Background="#1E222B"
                                Foreground="#C0C0C0">
                                <StackPanel>
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock Style="{DynamicResource mdBodyTextBlock}" Text="设备电压" />
                                        <md:Card
                                            HorizontalAlignment="Right"
                                            Background="{DynamicResource MaterialDesignColor.Blue400}"
                                            Content="正常" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="25"
                                            FontWeight="DemiBold"
                                            Foreground="White"
                                            Style="{DynamicResource MaterialDesignHeadlineTextBlock}"
                                            Text="5.12v" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="Green"
                                            Style="{DynamicResource MaterialDesignBody2TextBlock}"
                                            Text="0.00v" />
                                    </Grid>

                                    <ProgressBar
                                        Foreground="{DynamicResource MaterialDesignColor.Blue400}"
                                        Style="{DynamicResource MaterialDesignLinearProgressBar}"
                                        Value="45" />
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="4.5v" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="正常范围" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="5.5v" />
                                    </Grid>
                                </StackPanel>
                            </md:Card>
                            <UniformGrid Margin="0,14,0,0" Columns="2">
                                <Button
                                    Margin="0,0,5,0"
                                    md:ButtonAssist.CornerRadius="6"
                                    Content="刷新数据" />
                                <Button
                                    Margin="5,0,0,0"
                                    md:ButtonAssist.CornerRadius="6"
                                    Background="#343E4E"
                                    BorderBrush="DarkGray"
                                    Content="历史数据"
                                    Foreground="White"
                                    Style="{DynamicResource MaterialDesignOutlinedDarkButton}" />
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="10"
                    Padding="5"
                    Background="#272E3B"
                    CornerRadius="5">
                    <StackPanel>
                        <DockPanel Margin="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="温湿度趋势图" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button
                                    Margin="10,0,0,0"
                                    md:ButtonAssist.CornerRadius="15"
                                    Background="#165DFF"
                                    Content="24小时"
                                    Foreground="White"
                                    Style="{DynamicResource MaterialDesignOutlinedDarkButton}" />
                                <Button
                                    Margin="10,0,0,0"
                                    md:ButtonAssist.CornerRadius="15"
                                    Background="#165DFF"
                                    Content="7天"
                                    Foreground="White"
                                    Style="{DynamicResource MaterialDesignOutlinedDarkButton}" />
                                <Button
                                    Margin="10,0,0,0"
                                    md:ButtonAssist.CornerRadius="15"
                                    Background="#165DFF"
                                    Content="30天"
                                    Foreground="White"
                                    Style="{DynamicResource MaterialDesignOutlinedDarkButton}" />
                            </StackPanel>
                        </DockPanel>
                        <!--  温湿度趋势图占位符  -->
                        <md:Card
                            Height="480"
                            Margin="10"
                            Padding="10">
                            <lvc:CartesianChart
                                Series="{Binding Series}"
                                XAxes="{Binding XAxes}"
                                YAxes="{Binding YAxes}" />
                        </md:Card>
                    </StackPanel>

                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="10"
                    Padding="5"
                    Background="#272E3B"
                    CornerRadius="5">

                    <StackPanel>
                        <DockPanel>
                            <TextBlock
                                Margin="10"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="设备状态列表" />
                            <Button
                                Margin="10"
                                HorizontalAlignment="Right"
                                Content="查看全部"
                                Foreground="#2063DF"
                                Style="{DynamicResource MaterialDesignFlatButton}" />
                        </DockPanel>
                        <ListView
                            Height="200"
                            Foreground="White"
                            ItemsSource="{Binding Devies}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn DisplayMemberBinding="{Binding PortName}" Header="设备编号" />
                                    <GridViewColumn DisplayMemberBinding="{Binding Position}" Header="位置" />
                                    <GridViewColumn DisplayMemberBinding="{Binding Temperature}" Header="温度" />
                                    <GridViewColumn DisplayMemberBinding="{Binding Humidity}" Header="湿度" />
                                    <GridViewColumn DisplayMemberBinding="{Binding Status}" Header="状态">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Border
                                                        Margin="10"
                                                        Style="{StaticResource StatusIndicatorStyle}"
                                                        Tag="Error" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Foreground="White"
                                                        Text="{Binding Status}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn DisplayMemberBinding="{Binding LastUpdated}" Header="最后更新" />
                                    <GridViewColumn DisplayMemberBinding="{Binding Command}" Header="操作" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="10"
                    Padding="5"
                    Background="#272E3B"
                    CornerRadius="5">
                    <TextBlock
                        Margin="10"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="通知中心" />
                </Border>
            </Grid>
        </Grid>

    </ScrollViewer>
</UserControl>
