<UserControl
    x:Class="DualModeMonitorSystem.Views.AddRegisterMappingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conver="clr-namespace:DualModeMonitorSystem.Convert"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:MonitorLibrary.Models.Enums;assembly=MonitorLibrary"
    xmlns:local="clr-namespace:DualModeMonitorSystem"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="380"
    prism:ViewModelLocator.AutoWireViewModel="True"
    d:DesignHeight="550"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conver:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </UserControl.Resources>

    <materialDesign:Card
        Background="#272E3B"
        Foreground="White"
        UniformCornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="20"
                BorderBrush="#374151"
                BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        VerticalAlignment="Center"
                        Foreground="#165DFF"
                        Kind="TableEdit" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="新增寄存器映射" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="25,20">
                <StackPanel.Resources>
                    <Style BasedOn="{StaticResource MaterialDesignOutlinedTextBox}" TargetType="TextBox">
                        <Setter Property="Margin" Value="0,0,0,15" />
                        <Setter Property="Background" Value="#1D2129" />
                        <Setter Property="BorderBrush" Value="#4B5563" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="materialDesign:HintAssist.Foreground" Value="#9CA3AF" />
                    </Style>
                    <Style BasedOn="{StaticResource MaterialDesignOutlinedComboBox}" TargetType="ComboBox">
                        <Setter Property="Margin" Value="0,0,0,15" />
                        <Setter Property="Background" Value="#1D2129" />
                        <Setter Property="BorderBrush" Value="#4B5563" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="materialDesign:HintAssist.Foreground" Value="#9CA3AF" />
                        <Setter Property="Padding" Value="10" />
                        <Setter Property="Height" Value="42" />
                    </Style>
                </StackPanel.Resources>

                <TextBox
                    materialDesign:HintAssist.Hint="数据类型 (如: 温度)"
                    Text="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox
                    materialDesign:HintAssist.Hint="寄存器地址 (Hex, 如: 0x0001)"
                    Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox
                    materialDesign:HintAssist.Hint="数据格式"
                    ItemsSource="{local:EnumBindingSource EnumType=enums:ModbusDataFormat}"
                    SelectedItem="{Binding Format}"
                    SelectedValuePath="Value">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.Resources>
                        <SolidColorBrush x:Key="MaterialDesignPaper" Color="#272E3B" />
                    </ComboBox.Resources>
                </ComboBox>

                <TextBox
                    materialDesign:HintAssist.Hint="单位 (如: °C, %RH)"
                    Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        materialDesign:HintAssist.Hint="系数 (Factor)"
                        Text="{Binding Factor, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox
                        Grid.Column="2"
                        materialDesign:HintAssist.Hint="偏移量 (Offset)"
                        Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>

            <StackPanel
                Grid.Row="2"
                Margin="20"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    MinWidth="80"
                    Margin="0,0,10,0"
                    Background="Transparent"
                    BorderBrush="#4B5563"
                    BorderThickness="1"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    Foreground="#9CA3AF"
                    Style="{StaticResource MaterialDesignFlatButton}" />
                <Button
                    MinWidth="80"
                    Background="#165DFF"
                    BorderThickness="0"
                    Command="{Binding ConfirmCommand}"
                    Content="确定"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>