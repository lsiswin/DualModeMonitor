<UserControl
    x:Class="DualModeMonitorSystem.Views.AddRegisterMappingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conver="clr-namespace:DualModeMonitorSystem.Convert"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:MonitorLibrary.Models.Enums;assembly=MonitorLibrary"
    xmlns:local="clr-namespace:DualModeMonitorSystem"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
    xmlns:prism="http://prismlibrary.com/"
    Width="480" 
    prism:ViewModelLocator.AutoWireViewModel="True"
    d:DesignHeight="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conver:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
        <SolidColorBrush x:Key="MaterialDesignPaper" Color="#272E3B" />
        <conver:RadioButtonToEnumConverter x:Key="RadioButtonToEnumConverter" />

        <Style x:Key="DialogTextBoxStyle" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}" TargetType="TextBox">
            <Setter Property="Background" Value="#1D2129" />
            <Setter Property="BorderBrush" Value="#4B5563" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="materialDesign:HintAssist.Foreground" Value="#9CA3AF" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0,10,0" />
        </Style>

        <Style x:Key="DialogComboBoxStyle" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}" TargetType="ComboBox">
            <Setter Property="Background" Value="#1D2129" />
            <Setter Property="BorderBrush" Value="#4B5563" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="materialDesign:HintAssist.Foreground" Value="#9CA3AF" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style x:Key="DialogNumericUpDownStyle" BasedOn="{StaticResource MaterialDesignOutlinedNumericUpDown}" TargetType="{x:Type md:NumericUpDown}">
            <Setter Property="Background" Value="#1D2129" />
            <Setter Property="BorderBrush" Value="#4B5563" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="materialDesign:HintAssist.Background" Value="#1D2129" />
            <Setter Property="materialDesign:HintAssist.Foreground" Value="#9CA3AF" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,15,0,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

    </UserControl.Resources>

    <materialDesign:Card
        Background="#272E3B"
        Foreground="White"
        UniformCornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="20"
                BorderBrush="#374151"
                BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        VerticalAlignment="Center"
                        Foreground="#165DFF"
                        Kind="TableEdit" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="数据点配置 (CurrentDataPoint)" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,10,20,20">

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="基本信息与转换系数" />

                    <UniformGrid Margin="0,0,0,10" Columns="2" HorizontalAlignment="Stretch">
                        <TextBox
                            Margin="0,0,10,15"
                            Style="{StaticResource DialogTextBoxStyle}"
                            materialDesign:HintAssist.Hint="数据点名称 (如: 温度)"
                            Text="{Binding CurrentDataPoint.Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBox
                            Margin="10,0,0,15"
                            Style="{StaticResource DialogTextBoxStyle}"
                            materialDesign:HintAssist.Hint="数据点编码 (如: Temp)"
                            Text="{Binding CurrentDataPoint.Code, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBox
                            Margin="0,0,10,15"
                            Style="{StaticResource DialogTextBoxStyle}"
                            materialDesign:HintAssist.Hint="单位 (如: °C, %RH)"
                            Text="{Binding CurrentDataPoint.Unit, UpdateSourceTrigger=PropertyChanged}" />

                        <md:NumericUpDown
                            Margin="10,0,0,15"
                            Style="{StaticResource DialogNumericUpDownStyle}"
                            materialDesign:HintAssist.Hint="采集间隔 (秒, 1-3600)"
                            Minimum="1"
                            Maximum="3600"
                            Value="{Binding CurrentDataPoint.CollectInterval}" />

                        <md:NumericUpDown
                            Margin="0,0,10,0"
                            Style="{StaticResource DialogNumericUpDownStyle}"
                            materialDesign:HintAssist.Hint="系数 (Factor)"
                            Value="{Binding CurrentDataPoint.ModbusConfig.Factor}" />

                        <md:NumericUpDown
                            Margin="10,0,0,0"
                            Style="{StaticResource DialogNumericUpDownStyle}"
                            materialDesign:HintAssist.Hint="偏移量 (Offset)"
                            Value="{Binding CurrentDataPoint.ModbusConfig.Offset}" />
                    </UniformGrid>

                    <Separator Margin="0,0,0,5" Style="{StaticResource MaterialDesignDarkSeparator}" />

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Modbus协议设置" />

                    <UniformGrid Margin="0,5,0,5" Columns="2" HorizontalAlignment="Stretch">

                        <StackPanel Margin="0,0,10,15">
                            <TextBlock Margin="0,0,0,5" FontSize="12" Foreground="#9CA3AF" Text="从站地址 (1-255)" />
                            <md:NumericUpDown
                                Style="{StaticResource DialogNumericUpDownStyle}"
                                Maximum="255"
                                Minimum="1"
                                Value="{Binding CurrentDataPoint.ModbusConfig.DeviceAddress}" />
                        </StackPanel>

                        <StackPanel Margin="10,0,0,15">
                            <TextBlock Margin="0,0,0,5" FontSize="12" Foreground="#9CA3AF" Text="起始地址 (0-65535)" />
                            <md:NumericUpDown
                                Style="{StaticResource DialogNumericUpDownStyle}"
                                Maximum="65535"
                                Minimum="0"
                                Value="{Binding CurrentDataPoint.ModbusConfig.RegisterStart}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,10,15">
                            <TextBlock Margin="0,0,0,5" FontSize="12" Foreground="#9CA3AF" Text="功能码" />
                            <ComboBox
                                Style="{StaticResource DialogComboBoxStyle}"
                                ItemsSource="{local:EnumBindingSource enums:ModbusFunctionCode}"
                                SelectedItem="{Binding CurrentDataPoint.ModbusConfig.FunctionCode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="10,0,0,15">
                            <TextBlock Margin="0,0,0,5" FontSize="12" Foreground="#9CA3AF" Text="数据格式" />
                            <ComboBox
                                Style="{StaticResource DialogComboBoxStyle}"
                                ItemsSource="{local:EnumBindingSource EnumType=enums:ModbusDataFormat}"
                                SelectedItem="{Binding CurrentDataPoint.ModbusConfig.DataFormat}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Margin="0,0,0,5">
                        <TextBlock Margin="0,0,0,5" FontSize="12" Foreground="#9CA3AF" Text="字节序" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="40">
                            <RadioButton
                            Margin="0,0,15,0"
                            Background="#36CFC9"
                            Content="大端 (Big-Endian)"
                            Foreground="White"
                            GroupName="ByteOrder"
                            IsChecked="{Binding ModbusConfig.Endianness, Converter={StaticResource RadioButtonToEnumConverter}, ConverterParameter={x:Static enums:ModbusByteOrder.BigEndian}}" />
                                                    <RadioButton
                            Background="#165DFF"
                            Content="小端 (Little-Endian)"
                            Foreground="White"
                            GroupName="ByteOrder"
                            IsChecked="{Binding ModbusConfig.Endianness, Converter={StaticResource RadioButtonToEnumConverter}, ConverterParameter={x:Static enums:ModbusByteOrder.LittleEndian}}" />   
                        </StackPanel>
                    </StackPanel>
                    <Separator Margin="0,0,0,5" Style="{StaticResource MaterialDesignDarkSeparator}" />

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="告警阈值与数据校验" />

                    <UniformGrid Margin="0,0,0,10" Columns="2" HorizontalAlignment="Stretch">

                        <md:NumericUpDown
                            Margin="0,0,10,15"
                            Style="{StaticResource DialogNumericUpDownStyle}"
                            materialDesign:HintAssist.Hint="上限阈值 (UpperLimit)"
                            Value="{Binding CurrentDataPoint.UpperLimit}" />

                        <md:NumericUpDown
                            Margin="10,0,0,15"
                            Style="{StaticResource DialogNumericUpDownStyle}"
                            materialDesign:HintAssist.Hint="下限阈值 (LowerLimit)"
                            Value="{Binding CurrentDataPoint.LowerLimit}" />

                        <md:NumericUpDown
                            Margin="0,0,10,0"
                            Style="{StaticResource DialogNumericUpDownStyle}"
                            materialDesign:HintAssist.Hint="有效最大值 (ValidMax)"
                            Value="{Binding CurrentDataPoint.ValidMax}" />

                        <md:NumericUpDown
                            Margin="10,0,0,0"
                            Style="{StaticResource DialogNumericUpDownStyle}"
                            materialDesign:HintAssist.Hint="有效最小值 (ValidMin)"
                            Value="{Binding CurrentDataPoint.ValidMin}" />
                    </UniformGrid>

                    <Separator Margin="0,0,0,10" Style="{StaticResource MaterialDesignDarkSeparator}" />

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="告警策略与数据保留" />

                    <UniformGrid Columns="2" HorizontalAlignment="Stretch">

                        <md:NumericUpDown
                            Margin="0,0,10,15"
                            Style="{StaticResource DialogNumericUpDownStyle}"
                            materialDesign:HintAssist.Hint="数据保留天数 (1-3650)"
                            Minimum="1"
                            Maximum="3650"
                            Value="{Binding CurrentDataPoint.DataRetentionDays}" />

                        <md:NumericUpDown
                            Margin="10,0,0,15"
                            Style="{StaticResource DialogNumericUpDownStyle}"
                            materialDesign:HintAssist.Hint="告警延迟 (秒)"
                            Minimum="0"
                            Value="{Binding CurrentDataPoint.AlarmDelay}" />
                    </UniformGrid>

                    <CheckBox
                        Margin="0,10,0,0"
                        Content="启用告警功能"
                        Foreground="White"
                        IsChecked="{Binding CurrentDataPoint.EnableAlarm}"
                        Style="{StaticResource MaterialDesignCheckBox}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Margin="0,15,25,15"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    MinWidth="80"
                    Margin="0,0,10,0"
                    Background="Transparent"
                    BorderBrush="#4B5563"
                    BorderThickness="1"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    Foreground="#9CA3AF"
                    Style="{StaticResource MaterialDesignFlatButton}" />
                <Button
                    MinWidth="80"
                    Background="#165DFF"
                    BorderThickness="0"
                    Command="{Binding ConfirmCommand}"
                    Content="确定"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>