<UserControl
    x:Class="DualModeMonitorSystem.Views.AddRegisterMappingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conver="clr-namespace:DualModeMonitorSystem.Convert"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:MonitorLibrary.Models.Enums;assembly=MonitorLibrary"
    xmlns:local="clr-namespace:DualModeMonitorSystem"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="300"
    Height="450"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#272E3B"
    Foreground="White"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conver:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </UserControl.Resources>

    <!--  主容器 Grid  -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  标题  -->
            <RowDefinition Height="*" />
            <!--  表单内容  -->
            <RowDefinition Height="Auto" />
            <!--  按钮  -->
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,10,0,20"
            HorizontalAlignment="Center"
            FontSize="18"
            FontWeight="SemiBold"
            Text="新增寄存器" />

        <!--  表单内容  -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  数据类型  -->
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,10,15"
                VerticalAlignment="Center"
                Text="数据类型:" />
            <TextBox
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,0,15"
                Text="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" />

            <!--  寄存器地址  -->
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,10,15"
                VerticalAlignment="Center"
                Text="寄存器地址:" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,0,15"
                Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

            <!--  数据格式  -->
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,0,10,15"
                VerticalAlignment="Center"
                Text="数据格式:" />
            <ComboBox
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,0,0,15"
                ItemsSource="{local:EnumBindingSource EnumType=enums:ModbusDataFormat}"
                SelectedItem="{Binding Format}"
                SelectedValuePath="Value"
                Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!--  单位  -->
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Margin="0,0,10,15"
                VerticalAlignment="Center"
                Text="单位:" />
            <TextBox
                Grid.Row="3"
                Grid.Column="1"
                Margin="0,0,0,15"
                Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" />

            <!--  系数  -->
            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                Margin="0,0,10,15"
                VerticalAlignment="Center"
                Text="系数:" />
            <TextBox
                Grid.Row="4"
                Grid.Column="1"
                Margin="0,0,0,15"
                Text="{Binding Factor, UpdateSourceTrigger=PropertyChanged}" />

            <!--  偏移量  -->
            <TextBlock
                Grid.Row="5"
                Grid.Column="0"
                Margin="0,0,10,15"
                VerticalAlignment="Center"
                Text="偏移量:" />
            <TextBox
                Grid.Row="5"
                Grid.Column="1"
                Margin="0,0,0,15"
                Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" />


        </Grid>

        <!--  按钮  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                MinWidth="80"
                Margin="0,0,10,0"
                Command="{Binding CancelCommand}"
                Content="取消"
                Style="{StaticResource MaterialDesignOutlinedButton}" />
            <Button
                MinWidth="80"
                Command="{Binding ConfirmCommand}"
                Content="确定"
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>

    </Grid>
</UserControl>