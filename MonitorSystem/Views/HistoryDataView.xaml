<UserControl
    x:Class="DualModeMonitorSystem.Views.HistoryDataView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="900"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <Grid Background="#1E222B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <materialDesign:Card
            Grid.Row="0"
            Margin="10"
            Padding="15"
            Background="#272E3B"
            UniformCornerRadius="6">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,15,0" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        Foreground="#9CA3AF"
                        Text="开始时间" />
                    <DatePicker
                        Width="140"
                        materialDesign:HintAssist.Hint="Pick Date"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
                </StackPanel>

                <TextBlock VerticalAlignment="Center" Foreground="#6B7280" Text="—" Margin="0,15,15,0"/>

                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        Foreground="#9CA3AF"
                        Text="结束时间" />
                    <DatePicker
                        Width="140"
                        materialDesign:HintAssist.Hint="Pick Date"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
                </StackPanel>

                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        Foreground="#9CA3AF"
                        Text="目标设备" />
                    <ComboBox
                        Width="180"
                        materialDesign:HintAssist.Hint="选择设备"
                        Foreground="White"
                        ItemsSource="{Binding DeviceList}"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}" />
                </StackPanel>

                <Button
                    Height="40"
                    Margin="0,20,10,0"
                    Background="#165DFF"
                    Command="{Binding QueryCommand}"
                    Content="查询数据"
                    Style="{StaticResource MaterialDesignRaisedButton}" />

                <Button
                    Height="40"
                    Margin="0,20,0,0"
                    Background="#272E3B"
                    BorderBrush="#36CFC9"
                    BorderThickness="1"
                    Content="导出Excel"
                    Foreground="#36CFC9"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcel" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="导出"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </WrapPanel>
        </materialDesign:Card>

        <materialDesign:Card
            Grid.Row="1"
            Margin="10,0,10,0"
            Padding="15"
            Background="#272E3B"
            UniformCornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="数据趋势分析" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <RadioButton
                            Content="温度"
                            IsChecked="True"
                            Style="{StaticResource MaterialDesignTabRadioButton}" />
                        <RadioButton
                            Margin="10,0,0,0"
                            Content="湿度"
                            Style="{StaticResource MaterialDesignTabRadioButton}" />
                    </StackPanel>
                </DockPanel>

                <lvc:CartesianChart
                    Foreground="White"
                    Grid.Row="1"
                    Series="{Binding HistorySeries}"
                    XAxes="{Binding HistoryXAxes}"
                    YAxes="{Binding HistoryYAxes}"
                    ZoomMode="X" />
            </Grid>
        </materialDesign:Card>

        <GridSplitter
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            Background="#1E222B" />

        <materialDesign:Card
            Grid.Row="3"
            Margin="10"
            Padding="0"
            Background="#272E3B"
            UniformCornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="15"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="详细记录表" />

                <DataGrid
                    Grid.Row="1"
                    materialDesign:DataGridAssist.SelectedCellBorderBrush="Crimson"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    BorderBrush="#374151"
                    BorderThickness="0,1,0,0"
                    CanUserAddRows="False"
                    CanUserSortColumns="True"
                    Foreground="White"
                    HeadersVisibility="All"
                    IsReadOnly="True"
                    ItemsSource="{Binding HistoryRecords}">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1D2129" />
                            <Setter Property="Foreground" Value="#9CA3AF" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#E5E7EB" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#374151" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#165DFF" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                            Header="采集时间"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding DeviceName}"
                            Header="设备名称"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding Parameter}"
                            Header="参数"
                            Width="0.8*" />
                        <DataGridTextColumn
                            Binding="{Binding Value}"
                            Header="数值"
                            FontWeight="Bold"
                            Width="0.8*" />
                        <DataGridTextColumn
                            Binding="{Binding Unit}"
                            Header="单位"
                            Width="0.5*" />
                        <DataGridTemplateColumn Header="状态" Width="0.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1552C41A" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="正常" Foreground="#52C41A" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel
                    Grid.Row="2"
                    Margin="10"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="&lt; 上一页" Foreground="White"/>
                    <TextBlock VerticalAlignment="Center" Text="第 1 / 15 页" Foreground="#9CA3AF" Margin="10,0"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="下一页 &gt;" Foreground="White"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>