<UserControl
    x:Class="DualModeMonitorSystem.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:DualModeMonitorSystem.Convert"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DualModeMonitorSystem.Views"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vm="clr-namespace:DualModeMonitorSystem.ViewModels"
    d:DataContext="{d:DesignInstance vm:DashboardViewModel,
                                     IsDesignTimeCreatable=True}"
    d:Height="1200"
    d:Width="1378"
    mc:Ignorable="d">
    <UserControl.Resources>
        <convert:AlertLevelToColorConverter x:Key="AlertLevelToColorConverter" />
        <convert:StatusToColorConverter x:Key="AlertStatusToColorConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Hidden">

        <Grid Background="#1E222B">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ItemsControl ItemsSource="{Binding StatisticsResult}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <md:Card Margin="10" Background="#272E3B">
                            <DockPanel>
                                <StackPanel Margin="10">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="ExtraLight"
                                        Foreground="#C0C0C0"
                                        Text="{Binding Title}" />
                                    <TextBlock
                                        Margin="0,10"
                                        FontSize="23"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding Value}" />
                                </StackPanel>
                                <md:PackIcon
                                    Width="50"
                                    Height="50"
                                    Margin="0,20,10,0"
                                    HorizontalAlignment="Right"
                                    Foreground="BlueViolet"
                                    Kind="{Binding Icon}" />
                            </DockPanel>
                        </md:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="10"
                    Padding="5"
                    Background="#272E3B"
                    CornerRadius="5">
                    <StackPanel Margin="10">
                        <DockPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="实时监控数据" />
                            <Border
                                Padding="5"
                                HorizontalAlignment="Right"
                                Background="#374151"
                                CornerRadius="3">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="#BF4043"
                                    Text="最后更新: 10:24:35" />
                            </Border>
                        </DockPanel>
                        <TextBlock
                            Margin="0,20,0,5"
                            FontSize="13"
                            Foreground="#C0C0C0"
                            Text="选择设备" />
                        <Border Background="#1E222B">
                            <ComboBox
                                Padding="6"
                                md:HintAssist.Hint="设备#1 (车间A-1区)"
                                Foreground="White" />
                        </Border>
                        <StackPanel Margin="0,10">
                            <!--  温度监控卡片  -->
                            <md:Card
                                Margin="0,5"
                                Padding="12"
                                Background="#1E222B"
                                Foreground="#C0C0C0">
                                <StackPanel>
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock Style="{DynamicResource mdBodyTextBlock}" Text="当前温度" />
                                        <md:Card
                                            HorizontalAlignment="Right"
                                            Background="{DynamicResource MaterialDesignColor.Blue400}"
                                            Content="正常" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="25"
                                            FontWeight="DemiBold"
                                            Foreground="White"
                                            Style="{DynamicResource MaterialDesignHeadlineTextBlock}"
                                            Text="23.5 °C" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="Green"
                                            Style="{DynamicResource MaterialDesignBody2TextBlock}"
                                            Text="0.2°C" />
                                    </Grid>

                                    <ProgressBar
                                        Foreground="{DynamicResource MaterialDesignColor.Blue400}"
                                        Style="{DynamicResource MaterialDesignLinearProgressBar}"
                                        Value="45" />
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="0°C" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="阈值: 30°C" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="50°C" />
                                    </Grid>
                                </StackPanel>
                            </md:Card>
                            <!--  湿度监控卡片  -->
                            <md:Card
                                Margin="0,5"
                                Padding="12"
                                Background="#1E222B"
                                Foreground="#C0C0C0">
                                <StackPanel>
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock Style="{DynamicResource mdBodyTextBlock}" Text="当前湿度" />
                                        <md:Card
                                            HorizontalAlignment="Right"
                                            Background="{DynamicResource MaterialDesignColor.Blue400}"
                                            Content="正常" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="25"
                                            FontWeight="DemiBold"
                                            Foreground="White"
                                            Style="{DynamicResource MaterialDesignHeadlineTextBlock}"
                                            Text="45.2%" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="Green"
                                            Style="{DynamicResource MaterialDesignBody2TextBlock}"
                                            Text="1.3%" />
                                    </Grid>

                                    <ProgressBar
                                        Foreground="{DynamicResource MaterialDesignColor.Blue400}"
                                        Style="{DynamicResource MaterialDesignLinearProgressBar}"
                                        Value="45" />
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="0%" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="阈值: 60%" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="100%" />
                                    </Grid>
                                </StackPanel>
                            </md:Card>

                            <!--  设备电压监控卡片  -->
                            <md:Card
                                Margin="0,5"
                                Padding="12"
                                Background="#1E222B"
                                Foreground="#C0C0C0">
                                <StackPanel>
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock Style="{DynamicResource mdBodyTextBlock}" Text="设备电压" />
                                        <md:Card
                                            HorizontalAlignment="Right"
                                            Background="{DynamicResource MaterialDesignColor.Blue400}"
                                            Content="正常" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="25"
                                            FontWeight="DemiBold"
                                            Foreground="White"
                                            Style="{DynamicResource MaterialDesignHeadlineTextBlock}"
                                            Text="5.12v" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="Green"
                                            Style="{DynamicResource MaterialDesignBody2TextBlock}"
                                            Text="0.00v" />
                                    </Grid>

                                    <ProgressBar
                                        Foreground="{DynamicResource MaterialDesignColor.Blue400}"
                                        Style="{DynamicResource MaterialDesignLinearProgressBar}"
                                        Value="45" />
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="4.5v" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="正常范围" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                            Text="5.5v" />
                                    </Grid>
                                </StackPanel>
                            </md:Card>
                            <UniformGrid Margin="0,14,0,0" Columns="2">
                                <Button
                                    Margin="0,0,5,0"
                                    md:ButtonAssist.CornerRadius="6"
                                    Content="刷新数据" />
                                <Button
                                    Margin="5,0,0,0"
                                    md:ButtonAssist.CornerRadius="6"
                                    Background="#343E4E"
                                    BorderBrush="DarkGray"
                                    Content="历史数据"
                                    Foreground="White"
                                    Style="{DynamicResource MaterialDesignOutlinedDarkButton}" />
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border
    Grid.Row="0"
    Grid.Column="1"
    Grid.ColumnSpan="2"
    Margin="10"
    Padding="5"
    Background="#272E3B"
    CornerRadius="5">
                    <StackPanel>
                        <DockPanel Margin="10">
                            <TextBlock
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Foreground="White"
                Text="温湿度趋势图" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button
                    Margin="10,0,0,0"
                    md:ButtonAssist.CornerRadius="15"
                    Background="#165DFF"
                    Content="24小时"
                    Foreground="White"
                    Style="{DynamicResource MaterialDesignOutlinedDarkButton}" />
                                <Button
                    Margin="10,0,0,0"
                    md:ButtonAssist.CornerRadius="15"
                    Background="#165DFF"
                    Content="7天"
                    Foreground="White"
                    Style="{DynamicResource MaterialDesignOutlinedDarkButton}" />
                                <Button
                    Margin="10,0,0,0"
                    md:ButtonAssist.CornerRadius="15"
                    Background="#165DFF"
                    Content="30天"
                    Foreground="White"
                    Style="{DynamicResource MaterialDesignOutlinedDarkButton}" />
                            </StackPanel>
                        </DockPanel>

                        <md:Card
            Height="480"
            Margin="10"
            Padding="0"
            Background="#1D2129"
            UniformCornerRadius="4">
                            <lvc:CartesianChart
                            Margin="10"
                            Foreground="White"
                            Background="Transparent"
                Series="{Binding Series}"
                XAxes="{Binding XAxes}"
                YAxes="{Binding YAxes}" />
                        </md:Card>
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    MaxHeight="450"
                    Margin="10"
                    Padding="5"
                    Background="#272E3B"
                    CornerRadius="5">

                    <StackPanel>
                        <DockPanel>
                            <TextBlock
                                Margin="10"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="设备状态列表" />
                            <Button
                                Margin="10"
                                HorizontalAlignment="Right"
                                Content="查看全部"
                                Foreground="#BF4043"
                                Style="{DynamicResource MaterialDesignFlatButton}" />
                        </DockPanel>
                        <Grid>
                            <ListView Foreground="White" ItemsSource="{Binding Devies}">
                                <!--  列表项容器样式（控制选中状态）  -->
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <!--  默认样式  -->
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Height" Value="35" />
                                        <!--  行高  -->

                                        <!--  选中时的样式（IsSelected=True）  -->
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <!--  选中行背景色  -->
                                                <Setter Property="Background" Value="#316AC5" />
                                                <!--  蓝色背景  -->
                                                <!--  选中行文字颜色  -->
                                                <Setter Property="Foreground" Value="White" />
                                                <!--  白色文字  -->
                                            </Trigger>
                                            <!--  鼠标悬停效果（可选）  -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#747C8B" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>

                                        <GridViewColumn Header="设备编号" HeaderTemplate="{StaticResource CenteredCellTemplate}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PortName}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn
                                            DisplayMemberBinding="{Binding Position}"
                                            Header="位置"
                                            HeaderTemplate="{StaticResource CenteredCellTemplate}" />
                                        <GridViewColumn
                                            DisplayMemberBinding="{Binding Temperature}"
                                            Header="温度"
                                            HeaderTemplate="{StaticResource CenteredCellTemplate}" />
                                        <GridViewColumn
                                            DisplayMemberBinding="{Binding Humidity}"
                                            Header="湿度"
                                            HeaderTemplate="{StaticResource CenteredCellTemplate}" />
                                        <GridViewColumn Header="状态" HeaderTemplate="{StaticResource CenteredCellTemplate}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border
                                                            Margin="0,0,10,0"
                                                            Style="{StaticResource StatusIndicatorStyle}"
                                                            Tag="{Binding Status}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Foreground="White"
                                                            Text="{Binding Status}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn
                                            DisplayMemberBinding="{Binding LastUpdated}"
                                            Header="最后更新"
                                            HeaderTemplate="{StaticResource CenteredCellTemplate}" />
                                        <GridViewColumn Header="操作" HeaderTemplate="{StaticResource CenteredCellTemplate}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Margin="10,0,0,0"
                                                        HorizontalAlignment="Center"
                                                        md:ButtonAssist.CornerRadius="4"
                                                        FontSize="15"
                                                        FontWeight="Bold"
                                                        Foreground="#BF4043"
                                                        Text="详情" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="2"
                    MaxHeight="450"
                    Margin="10"
                    Background="#272E3B"
                    CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  标题栏  -->
                        <Border
                            Grid.Row="0"
                            Padding="10,0"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="最近告警" />

                                <Button
                                    Margin="10"
                                    HorizontalAlignment="Right"
                                    Content="查看全部"
                                    Foreground="#BF4043"
                                    Style="{DynamicResource MaterialDesignFlatButton}" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Alerts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <md:Card
                                    Margin="0,0,0,10"
                                    Padding="10"
                                    Background="#272E3B"
                                    UniformCornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <md:PackIcon
                                            Grid.Column="0"
                                            Grid.RowSpan="2"
                                            Width="32"
                                            Height="32"
                                            Margin="0,0,15,0"
                                            VerticalAlignment="Top"
                                            Foreground="{Binding Level, Converter={StaticResource AlertLevelToColorConverter}}"
                                            Kind="AlertCircle" />

                                                <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Orientation="Horizontal">
                                                    <TextBlock
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" />
                                                    <TextBlock
                                                Margin="10,0,0,0"
                                                Foreground="#36CFC9"
                                                Text="{Binding DeviceName}" />
                                                </StackPanel>

                                                <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,4,0,0"
                                            FontSize="12"
                                            Foreground="#B3B7BB"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />

                                                <StackPanel Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button
                                                Padding="12,4"
                                                Background="{Binding Status, Converter={StaticResource AlertStatusToColorConverter}}"
                                                Command="{Binding ProcessAlertCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Status}"
                                                Foreground="White"
                                                Style="{StaticResource MaterialDesignFlatLightBgButton}" />
                                                </StackPanel>
                                            </Grid>
                                        </md:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </ScrollViewer>
</UserControl>
