<UserControl
    x:Class="DualModeMonitorSystem.Views.RealTimeMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800" d:DesignWidth="1200" mc:Ignorable="d">

    <UserControl.Resources>
        <DropShadowEffect x:Key="StandardShadow" BlurRadius="10" Opacity="0.3" ShadowDepth="1" Color="Black"/>

        <SolidColorBrush x:Key="GoodBrush" Color="#52C41A"/>
        <SolidColorBrush x:Key="BadBrush" Color="#F5222D"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#FAAD14"/>
        <DataTemplate x:Key="CardModeTemplate">
            <materialDesign:Card Margin="10" Background="#272E3B" UniformCornerRadius="12" Width="280" Height="180">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <Border Padding="15,10" Background="#313A4A" CornerRadius="12,12,0,0">
                        <TextBlock Text="{Binding DeviceName}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="温度" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Temperature, StringFormat={}{0:F1}}" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Separator Grid.Column="1" Height="40" Background="#374151" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="湿度" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Humidity, StringFormat={}{0:F1}}" FontSize="32" FontWeight="Bold" Foreground="#36CFC9" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="#1D2129" CornerRadius="0,0,12,12" Padding="12,0">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE" Foreground="#52C41A" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="{Binding LastUpdate, StringFormat={}{0:HH:mm:ss}}" Foreground="#4B5563" FontSize="10" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </DataTemplate>

        <DataTemplate x:Key="ListModeTemplate">
            <materialDesign:Card Margin="10,4" Padding="15,10" Background="#2C3544" UniformCornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ExpansionCardVariant" Foreground="#165DFF"/>
                        <TextBlock Text="{Binding DeviceName}" Foreground="White" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Temperature,Mode=TwoWay}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="℃" Foreground="#6B7280" FontSize="10" Margin="4,4,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Humidity,Mode=TwoWay}" Foreground="#36CFC9" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="%RH" Foreground="#6B7280" FontSize="10" Margin="4,4,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="{Binding LastUpdate, StringFormat={}{0:HH:mm:ss}}" 
                       Foreground="#4B5563" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </materialDesign:Card>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="#1E222B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Margin="10" Padding="15" Background="#272E3B">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="实时监测终端" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/> 
                    <ComboBox Width="150" Margin="30,0,10,0" materialDesign:HintAssist.Hint="筛选区域" Style="{StaticResource MaterialDesignOutlinedComboBox}"/> 
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="卡片" Command="{Binding ChangeModeCommand}" CommandParameter="Card" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                    <Button Content="列表" Command="{Binding ChangeModeCommand}" CommandParameter="List" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                    </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MonitorNodes}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DisplayMode}" Value="List">
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource CardModeTemplate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="List">
                                            <Setter Property="ContentTemplate" Value="{StaticResource ListModeTemplate}"/>
                                        </DataTrigger>
                                        
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>