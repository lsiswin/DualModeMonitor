<UserControl
    x:Class="DualModeMonitorSystem.Views.RealTimeMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <Grid Background="#1E222B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card
            Grid.Row="0"
            Margin="10"
            Padding="15"
            Background="#272E3B"
            UniformCornerRadius="6">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="实时监测终端" />

                    <ComboBox
                        Width="150"
                        Margin="30,0,10,0"
                        materialDesign:HintAssist.Hint="选择区域/车间"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBoxItem Content="全部区域" IsSelected="True" />
                        <ComboBoxItem Content="A区-发酵车间" />
                        <ComboBoxItem Content="B区-包装车间" />
                    </ComboBox>

                    <ComboBox
                        Width="120"
                        Margin="10,0,0,0"
                        materialDesign:HintAssist.Hint="设备状态"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBoxItem Content="全部" IsSelected="True" />
                        <ComboBoxItem Content="正常运行" />
                        <ComboBoxItem Content="告警中" />
                        <ComboBoxItem Content="离线" />
                    </ComboBox>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Margin="0,0,10,0"
                        Background="#343E4E"
                        BorderBrush="#4B5563"
                        Content="列表视图"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button
                        Background="#165DFF"
                        BorderThickness="0"
                        Content="大屏模式"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MonitorNodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card
                            Margin="10"
                            Padding="0"
                            Background="#272E3B"
                            UniformCornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Padding="15,10"
                                    BorderBrush="#374151"
                                    BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <materialDesign:PackIcon
                                            VerticalAlignment="Center"
                                            Foreground="#165DFF"
                                            Kind="RouterWireless" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="#E5E7EB"
                                            Text="{Binding DeviceName}" />

                                        <Border
                                            Padding="8,2"
                                            HorizontalAlignment="Right"
                                            Background="#1536CFC9"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#36CFC9"
                                                Text="在线" />
                                        </Border>
                                    </DockPanel>
                                </Border>

                                <StackPanel Grid.Row="1">
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9CA3AF"
                                                Text="温度(°C)" />
                                            <TextBlock
                                                FontSize="24"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="{Binding Temperature}" />
                                        </StackPanel>

                                        <Separator
                                            Grid.Column="1"
                                            Width="1"
                                            Height="30"
                                            Background="#374151" />

                                        <StackPanel Grid.Column="2" Margin="15,0,0,0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9CA3AF"
                                                Text="湿度(RH%)" />
                                            <TextBlock
                                                FontSize="24"
                                                FontWeight="Bold"
                                                Foreground="#36CFC9"
                                                Text="{Binding Humidity}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border
                                        Height="40"
                                        Background="Transparent"
                                        BorderBrush="#374151"
                                        BorderThickness="0,1,0,0">
                                        <lvc:CartesianChart
                                            Margin="0,5,0,0"
                                            Series="{Binding MiniTrendSeries}"
                                            TooltipPosition="Hidden"
                                            XAxes="{Binding MiniXAxes}"
                                            YAxes="{Binding MiniYAxes}" />
                                    </Border>
                                </StackPanel>

                                <Border
                                    Grid.Row="2"
                                    Padding="15,8"
                                    Background="#1D2129"
                                    CornerRadius="0,0,8,8">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Foreground="#9CA3AF"
                                                Kind="MapMarker" />
                                            <TextBlock
                                                Margin="4,0,0,0"
                                                FontSize="11"
                                                Foreground="#9CA3AF"
                                                Text="{Binding Location}" />
                                        </StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="11"
                                            Foreground="#6B7280"
                                            Text="10s前更新" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>