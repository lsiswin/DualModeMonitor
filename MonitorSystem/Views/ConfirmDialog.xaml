<UserControl
    x:Class="DualModeMonitorSystem.Views.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DualModeMonitorSystem.Views"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    
    prism:ViewModelLocator.AutoWireViewModel="True"
    Width="380"
    Height="200" mc:Ignorable="d"
    d:DesignHeight="200"
    d:DesignWidth="380">

    <md:Card 
        Height="Auto"
        Background="{DynamicResource MaterialDesignPaper}" 
        Foreground="White"
        UniformCornerRadius="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,15,20,10">
                <TextBlock 
                    FontSize="18" 
                    FontWeight="Bold" 
                    Text="{Binding Title}" />
                <Separator 
                    Style="{StaticResource MaterialDesignDarkSeparator}" 
                    Margin="0,5,0,0" />
            </StackPanel>

            <ScrollViewer 
                Grid.Row="1" 
                VerticalScrollBarVisibility="Auto" 
                MaxHeight="200">
                <Grid Margin="20,15,20,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <md:PackIcon 
                        Grid.Column="0"
                        Kind="AlertCircleOutline" 
                        Width="24" 
                        Height="24" 
                        Foreground="#FAAD14" 
                        VerticalAlignment="Top" Margin="0, 0, 10, 0" Visibility="{Binding ShowWarningIcon, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}" />

                    <TextBlock 
                        Grid.Column="1"
                        Text="{Binding Message}" 
                        TextWrapping="Wrap" 
                        FontSize="14" 
                        Foreground="#C0C0C0" />
                </Grid>
            </ScrollViewer>

            <StackPanel
                Grid.Row="2"
                Margin="0,0,20,15"
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Button
                    MinWidth="80"
                    Margin="0,0,10,0"
                    Background="Transparent"
                    BorderBrush="#4B5563"
                    BorderThickness="1"
                    Command="{Binding CancelCommand}"
                    Content="{Binding CancelText, FallbackValue='取消'}"
                    Foreground="#9CA3AF"
                    Style="{StaticResource MaterialDesignFlatButton}" />

                <Button
                    MinWidth="80"
                    Background="{Binding ConfirmButtonColor, FallbackValue='#FF4D4F'}"
                    BorderThickness="0"
                    Command="{Binding ConfirmCommand}"
                    Content="{Binding ConfirmText, FallbackValue='删除'}"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>
        </Grid>
    </md:Card>
</UserControl>