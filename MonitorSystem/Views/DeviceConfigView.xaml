<UserControl
    x:Class="DualModeMonitorSystem.Views.DeviceConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:DualModeMonitorSystem.Convert"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:MonitorLibrary.Models.Enums;assembly=MonitorLibrary"
    xmlns:local="clr-namespace:DualModeMonitorSystem"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:sys="clr-namespace:System.IO.Ports;assembly=System"
    xmlns:vm="clr-namespace:DualModeMonitorSystem.ViewModels"
    d:Height="1200"
    d:Width="1378"
    mc:Ignorable="d">
    <UserControl.Resources>
        <convert:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <convert:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
        <convert:RadioButtonToEnumConverter x:Key="RadioButtonToEnumConverter" />

    </UserControl.Resources>
    <Grid Background="#1D2129" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <md:Card
            Grid.Column="0"
            Margin="20"
            Padding="0"
            Background="#272E3B"
            Foreground="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,20,20,10">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="设备列表" />
                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="12"
                        Foreground="#9CA3AF"
                        Text="选择要配置的设备" />

                    <StackPanel
                        Grid.Row="0"
                        Margin="0,10,0,0"
                        VerticalAlignment="Bottom">
                        <TextBox
                            Height="40"
                            Padding="10,0,10,0"
                            md:HintAssist.Hint="搜索设备..."
                            Background="#1D2129"
                            BorderBrush="#4B5563"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button
                            Height="35"
                            Margin="0,10,0,0"
                            Background="#165DFF"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <md:PackIcon
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    Kind="Magnify" />
                                <TextBlock Text="搜索" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>



                <Border Grid.Row="1">
                    <ListBox
                        Margin="10"
                        ItemsSource="{Binding Devices}"
                        SelectedItem="{Binding SelectDevice}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <md:Card
                                    Margin="0,0,0,10"
                                    Padding="15"
                                    Background="{Binding IsSelected}"
                                    Foreground="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="11"
                                                Foreground="#9CA3AF"
                                                Text="{Binding Location}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#9CA3AF"
                                                Text="{Binding DeviceCode}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="30,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                            <Border
                                                Width="8"
                                                Height="8"
                                                Margin="0,0,0,2"
                                                Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                CornerRadius="4" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                Text="{Binding Status}" />
                                        </StackPanel>
                                    </Grid>
                                </md:Card>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Border>
                <Button
                    Grid.Row="2"
                    Height="45"
                    Margin="20"
                    Background="#165DFF"
                    Command="{Binding AddDeviceCommand}"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,8,0"
                            Kind="Plus" />
                        <TextBlock Text="添加设备" />
                    </StackPanel>
                </Button>
            </Grid>
        </md:Card>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <md:Card
                Grid.Row="0"
                Margin="0,20,20,10"
                Padding="20"
                Background="#272E3B"
                Foreground="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <md:PackIcon
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,20,0"
                        Foreground="#165DFF"
                        Kind="Cog" />

                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="设备配置" />
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="12"
                            Foreground="#9CA3AF"
                            Text="配置设备通信参数和协议设置" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Border
                            Width="10"
                            Height="10"
                            Margin="0,0,8,0"
                            Background="{Binding SelectDevice.Status, Converter={StaticResource StatusToColorConverter}}"
                            CornerRadius="5" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{Binding SelectDevice.Status, Converter={StaticResource StatusToColorConverter}}"
                            Text="{Binding SelectDevice.Status, FallbackValue=在线}" />
                    </StackPanel>
                </Grid>
            </md:Card>

            <TabControl
                Grid.Row="1"
                Margin="0,0,20,20"
                Background="Transparent"
                BorderThickness="0"
                Foreground="White"
                SelectedIndex="{Binding SelectedTabIndex}">

                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="12" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Grid>
                                        <Border
                                            Name="Border"
                                            Background="Transparent"
                                            BorderThickness="0">
                                            <ContentPresenter
                                                x:Name="ContentSite"
                                                Margin="10,5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ContentSource="Header" />
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#165DFF" />
                                            <Setter TargetName="Border" Property="CornerRadius" Value="6" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#3A4556" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon
                                Foreground="White"
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                Kind="Usb" />
                            <TextBlock Text="串口配置" Foreground="White" />
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <md:Card
                            Padding="25"
                            Background="#272E3B"
                            Foreground="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <StackPanel Margin="0,0,0,25">
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Text="串口通信设置" />
                                        <TextBlock
                                            Margin="0,5,0,0"
                                            FontSize="12"
                                            Foreground="#9CA3AF"
                                            Text="配置RS485/RS232通信参数" />
                                    </StackPanel>

                                    <UniformGrid Margin="0,0,0,20" Columns="2">
                                        <StackPanel Margin="0,0,15,15">
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="串口端口" />
                                            <TextBox
                                                Height="40"
                                                Padding="10"
                                                Background="#1D2129"
                                                BorderBrush="#4B5563"
                                                Style="{StaticResource MaterialDesignTextBox}"
                                                Text="{Binding SerialPort.PortName}" />
                                        </StackPanel>

                                        <StackPanel Margin="15,0,0,15">
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="波特率" />
                                            <ComboBox
                                                Height="40"
                                                Padding="10"
                                                Background="#1D2129"
                                                BorderBrush="#4B5563"
                                                ItemsSource="{local:EnumBindingSource EnumType=enums:BaudRate}"
                                                SelectedItem="{Binding SerialPort.BaudRate}"
                                                Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,15,0">
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="数据位" />
                                            <ComboBox
                                                Height="40"
                                                Padding="10"
                                                Background="#1D2129"
                                                BorderBrush="#4B5563"
                                                ItemsSource="{local:EnumBindingSource EnumType=enums:DataBits}"
                                                SelectedItem="{Binding SerialPort.DataBits}"
                                                Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Margin="15,0,0,0">
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="停止位" />
                                            <ComboBox
                                                Height="40"
                                                Padding="10"
                                                Background="#1D2129"
                                                BorderBrush="#4B5563"
                                                ItemsSource="{local:EnumBindingSource EnumType=sys:StopBits}"
                                                SelectedItem="{Binding SerialPort.StopBits, Mode=TwoWay}"
                                                Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </UniformGrid>

                                    <UniformGrid Margin="0,0,0,20" Columns="2">
                                        <StackPanel Margin="0,0,15,0">
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="校验位" />
                                            <ComboBox
                                                Height="40"
                                                Padding="10"
                                                Background="#1D2129"
                                                BorderBrush="#4B5563"
                                                ItemsSource="{local:EnumBindingSource EnumType=sys:Parity}"
                                                SelectedItem="{Binding SerialPort.Parity, Mode=TwoWay}"
                                                Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Margin="15,0,0,0">
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="读取超时 (ms)" />
                                            <md:NumericUpDown
                                                Height="40"
                                                Padding="10"
                                                Background="#1D2129"
                                                BorderBrush="#4B5563"
                                                Maximum="10000"
                                                Minimum="100"
                                                Style="{StaticResource MaterialDesignOutlinedNumericUpDown}"
                                                Value="{Binding SerialPort.Timeout}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                        <Button
                                            Height="40"
                                            Margin="0,0,15,0"
                                            Padding="20,0"
                                            Background="#165DFF"
                                            Command="{Binding SaveSerialConfigCommand}"
                                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,8,0"
                                                    Kind="ContentSave" />
                                                <TextBlock Text="保存配置" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Height="40"
                                            Padding="20,0"
                                            Background="#343E4E"
                                            Command="{Binding TestConnectionCommand}"
                                            Style="{StaticResource MaterialDesignRaisedDarkButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,8,0"
                                                    Kind="Play" />
                                                <TextBlock Text="测试连接" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <md:Card
                                    Grid.Row="1"
                                    Margin="0,30"
                                    Padding="20"
                                    Background="#1D2129">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="连接状态" />

                                        <StackPanel Margin="0,20,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="8"
                                                    Height="8"
                                                    Margin="0,0,10,0"
                                                    Background="{Binding ConnectionStatus, Converter={StaticResource StatusToColorConverter}}"
                                                    CornerRadius="4" />
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding ConnectionStatus, Converter={StaticResource StatusToColorConverter}}"
                                                    Text="{Binding ConnectionStatus}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,15,0,0">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="#9CA3AF"
                                                    Text="最后通信时间" />
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding SelectedDevice.LastCommunicationTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="#9CA3AF"
                                                    Text="发送数据" />
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding SelectedDevice.BytesSent, StringFormat='{}{0:N0} bytes'}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="#9CA3AF"
                                                    Text="接收数据" />
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding SelectedDevice.BytesReceived, StringFormat='{}{0:N0} bytes'}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </md:Card>
                            </Grid>
                        </md:Card>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Foreground="White"
                Kind="TableSettings" />
                            <TextBlock Text="数据点映射管理" Foreground="White" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,15">
                            <Button
                DockPanel.Dock="Right"
                Height="36"
                Padding="15,0"
                Background="#165DFF"
                Command="{Binding AddRegisterMappingCommand}"
                Style="{StaticResource MaterialDesignRaisedButton}"
                ToolTip="新增一个数据点映射">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Plus" Margin="0,0,5,0" Width="18" Height="18" />
                                    <TextBlock Text="新增数据点" />
                                </StackPanel>
                            </Button>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <md:PackIcon
                    Width="20"
                    Height="20"
                    Margin="0,0,8,0"
                    Foreground="#165DFF"
                    Kind="Table" />
                                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                                    Foreground="White"
                    Text="设备数据点映射列表" />
                            </StackPanel>
                        </DockPanel>

                        <md:Card
            Grid.Row="1"
            Background="#1D2129"
            Padding="0"
            UniformCornerRadius="6"
            BorderBrush="#374151"
            BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <DataGrid
                    MinHeight="300"
                    md:DataGridAssist.SelectedCellBorderBrush="#165DFF"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    BorderThickness="0"
                    CanUserAddRows="False"
                    CanUserSortColumns="True" Foreground="White"
                    HeadersVisibility="All"
                    IsReadOnly="True"
                    ItemsSource="{Binding DataPoints}">

                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#272E3B" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="BorderBrush" Value="#4B5563" />
                                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                                            <Setter Property="Height" Value="40" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="10,0" />
                                        </Style>

                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Height" Value="60" />
                                            <Setter Property="Padding" Value="10"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#272E3B" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3A4556" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>

                                        <Style TargetType="DataGridCell">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="8,0" />
                                        </Style>
                                    </DataGrid.Resources>

                                    <DataGrid.GridLinesVisibility>All</DataGrid.GridLinesVisibility>
                                    <DataGrid.HorizontalGridLinesBrush>#4B5563</DataGrid.HorizontalGridLinesBrush>
                                    <DataGrid.VerticalGridLinesBrush>#4B5563</DataGrid.VerticalGridLinesBrush>

                                    <DataGrid.Columns>

                                        <DataGridTemplateColumn Width="1.2*" Header="数据点名称/Code">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                                        <md:PackIcon
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,5,0"
                                            Foreground="#FFC300"
                                            Kind="ChartLineVariant" />
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding Code, StringFormat=' ({0})'}" FontSize="11" Foreground="#9CA3AF" Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn
                                            Width="2*"
                                            Binding="{Binding ModbusConfig.Description}"
                                            Header="Modbus地址信息" >       
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="FontFamily" Value="Consolas, Courier New" />
                                                    <Setter Property="Text" Value="{Binding Description}" />
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        
                                        <DataGridTextColumn
                            Width="0.8*"
                            Binding="{Binding CollectInterval, StringFormat={}{0} S}"
                            Header="间隔" 
                           >
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTemplateColumn Width="1.5*" Header="告警 (上下限)">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <md:PackIcon Kind="ArrowUp" Width="12" Height="12" Foreground="#FF4D4F" VerticalAlignment="Center" />
                                                            <TextBlock Margin="2,0,5,0" Text="{Binding UpperLimit}" />
                                                            <md:PackIcon Kind="ArrowDown" Width="12" Height="12" Foreground="#49CC51" VerticalAlignment="Center" />
                                                            <TextBlock Margin="2,0,0,0" Text="{Binding LowerLimit}" FontWeight="SemiBold" />
                                                            <TextBlock Margin="2,0,0,0" FontSize="10" Foreground="#9CA3AF" Text="{Binding Unit}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock FontSize="10" Foreground="#9CA3AF" Text="{Binding AlarmDelay, StringFormat='延迟：{0}s'}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="0.8*" Header="启用告警">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                        <Ellipse
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#FF4D4F" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EnableAlarm}" Value="True">
                                                                            <Setter Property="Fill" Value="#49CC51" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding EnableAlarm}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="100" Header="操作">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                        <Button
                                            Margin="2"
                                            Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Foreground="#165DFF"
                                            Style="{StaticResource MaterialDesignToolButton}"
                                            ToolTip="编辑数据点">
                                                            <md:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="Edit" />
                                                        </Button>
                                                        <Button
                                            Margin="2"
                                            Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Foreground="#FF4D4F"
                                            Style="{StaticResource MaterialDesignToolButton}"
                                            ToolTip="删除映射">
                                                            <md:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="Delete" />
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ScrollViewer>
                        </md:Card>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>