<UserControl
    x:Class="DualModeMonitorSystem.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <Grid Background="#1E222B" Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="#272E3B"
            BorderBrush="#374151"
            BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock
                    Margin="20,25,20,15"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="系统设置" />

                <ListBox
                    x:Name="SettingsMenu"
                    FontSize="18"
                    Background="Transparent"
                    Foreground="White"
                    SelectedIndex="0">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                            <Setter Property="Height" Value="50"/>
                            <Setter Property="Margin" Value="5,2"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#165DFF"/>
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Resources>

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Margin="10,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="常规设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BellRing" Margin="10,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="报警参数" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Database" Margin="10,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="数据存储" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Information" Margin="10,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="关于软件" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" >
            <Grid Margin="30">
                <TabControl
                    FontSize="18"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedIndex="{Binding ElementName=SettingsMenu, Path=SelectedIndex}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <TabItem>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MaterialDesignHeadline5TextBlock}" Foreground="White" FontSize="30" Text="常规设置" Margin="0,0,0,20"/>

                            <materialDesign:Card Background="#272E3B" Padding="20" UniformCornerRadius="6" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="系统显示名称" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox Text="工业温湿度监控系统 V2.0" Foreground="White" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Background="#272E3B" Padding="20" UniformCornerRadius="6">
                                <StackPanel>
                                    <TextBlock Text="界面偏好" Foreground="White" FontWeight="Bold" Margin="0,0,0,15"/>

                                    <DockPanel Margin="0,0,0,15">
                                        <TextBlock Text="深色模式" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                                        <ToggleButton HorizontalAlignment="Right" IsChecked="True" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                    </DockPanel>
                                    <Separator Background="#374151" Margin="0,0,0,15"/>

                                    <DockPanel>
                                        <TextBlock Text="自动刷新间隔 (秒)" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                                        <materialDesign:NumericUpDown  Foreground="White" Value="5" Minimum="1" Maximum="60" HorizontalAlignment="Right" Width="100"/>
                                    </DockPanel>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>
                    </TabItem>

                    <TabItem>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MaterialDesignHeadline5TextBlock}" Foreground="White" Text="报警阈值配置" Margin="0,0,0,20"/>

                            <materialDesign:Card Background="#272E3B" Padding="20" UniformCornerRadius="6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <materialDesign:PackIcon Kind="Thermometer" Foreground="#FF4D4F" VerticalAlignment="Center"/>
                                                <TextBlock Text="全局温度报警阈值" Foreground="White" FontWeight="Bold" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="上限" VerticalAlignment="Center" Foreground="#9CA3AF"/>
                                                <Slider Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100" Value="45" Style="{StaticResource MaterialDesignDiscreteSlider}"/>
                                                <TextBlock Grid.Column="2" Text="45°C" Foreground="White" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <materialDesign:PackIcon Kind="WaterPercent" Foreground="#36CFC9" VerticalAlignment="Center"/>
                                                <TextBlock Text="全局湿度报警阈值" Foreground="White" FontWeight="Bold" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="上限" VerticalAlignment="Center" Foreground="#9CA3AF"/>
                                                <Slider Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100" Value="80" Style="{StaticResource MaterialDesignDiscreteSlider}"/>
                                                <TextBlock Grid.Column="2" Text="80%" Foreground="White" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Separator Background="#374151" Margin="0,10,0,20"/>

                                    <TextBlock Text="通知方式" Foreground="White" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <WrapPanel>
                                        <CheckBox Content="声音报警" IsChecked="True" Foreground="White" Margin="0,0,20,0"/>
                                        <CheckBox Content="弹窗提示" IsChecked="True" Foreground="White" Margin="0,0,20,0"/>
                                        <CheckBox Content="记录日志" IsChecked="True" Foreground="White" Margin="0,0,20,0"/>
                                    </WrapPanel>
                                </StackPanel>
                            </materialDesign:Card>

                            <Button HorizontalAlignment="Left" Margin="0,20,0,0" Content="保存报警设置" Background="#165DFF"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MaterialDesignHeadline5TextBlock}" Foreground="White" Text="数据库配置" Margin="0,0,0,20"/>

                            <materialDesign:Card Background="#272E3B" Padding="20" UniformCornerRadius="6">
                                <StackPanel>
                                    <TextBlock Text="本地存储 (SQLite)" Foreground="#36CFC9" FontWeight="Bold" Margin="0,0,0,15"/>

                                    <TextBox materialDesign:HintAssist.Hint="数据库路径" Text="D:\Data\MonitorDB.db" Foreground="White" Margin="0,0,0,15" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock Text="数据保留周期 (天)" Foreground="White" VerticalAlignment="Center"/>
                                        <ComboBox HorizontalAlignment="Right" Width="120" SelectedIndex="2" Foreground="White">
                                            <ComboBoxItem Content="30天"/>
                                            <ComboBoxItem Content="90天"/>
                                            <ComboBoxItem Content="180天"/>
                                            <ComboBoxItem Content="永久"/>
                                        </ComboBox>
                                    </DockPanel>

                                    <Button Margin="0,20,0,0" Style="{StaticResource MaterialDesignOutlinedButton}" Content="备份数据库" Foreground="#36CFC9" BorderBrush="#36CFC9" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>
                    </TabItem>

                    <TabItem>
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Factory" Width="60" Height="60" Foreground="#165DFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="工业温湿度监控系统" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,20,0,10" HorizontalAlignment="Center"/>
                                <TextBlock Text="Version 2.1.0 (Build 20241124)" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                <TextBlock Text="© 2024 DualMode Systems. All rights reserved." Foreground="#6B7280" Margin="0,40,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>