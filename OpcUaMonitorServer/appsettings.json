{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "OpcServer": {
    "ApplicationName": "Monitor OPC UA Server",
    "ApplicationUri": "urn:localhost:MonitorOPCServer",
    "ProductUri": "http://monitor.com/opcserver",
    "Port": 4840,
    "MaxSessionTimeout": 3600000,
    "MinSessionTimeout": 10000
  },
  "MonitorApi": {
    "BaseUrl": "http://localhost:5000/api"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "RequestedConnectionTimeout": 30000,
    "RequestedHeartbeat": 60,
    "AutomaticRecoveryEnabled": true,
    "NetworkRecoveryInterval": 10
  },
  "Exchange": {
    "DataTopic": "monitor.data.topic",
    "CommandDirect": "monitor.command.direct",
    "EventsFanout": "monitor.events.fanout",
    "AlarmTopic": "monitor.alarm.topic",
    "OpcTopic": "monitor.opc.topic"
  },
  "Queue": {
    "RealtimeData": "realtime.data.queue",
    "PersistData": "persist.data.queue",
    "OpcData": "opc.data.queue",
    "Alarm": "alarm.queue",
    "DeviceStatus": "device.status.queue"
  },
  "RoutingKey": {
    "RealtimeData": "data.realtime",
    "HistoricalData": "data.historical",
    "Alarm": "alarm.#",
    "DeviceStatus": "device.status",
    "OpcData": "opc.data"
  },
  "DataCollection": {
    "ScanIntervalMs": 5000,
    "RetryAttempts": 3,
    "RetryDelayMs": 1000
  }
}
