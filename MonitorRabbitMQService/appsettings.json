{
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "RequestedConnectionTimeout": 30000,
    "RequestedHeartbeat": 60,
    "AutomaticRecoveryEnabled": true,
    "NetworkRecoveryInterval": 10,

    "Exchanges": {
      "DataTopic": "monitor.data.topic",
      "CommandDirect": "monitor.command.direct",
      "EventsFanout": "monitor.events.fanout",
      "AlarmTopic": "monitor.alarm.topic",
      "OpcTopic": "monitor.opc.topic"
    },

    "Queues": {
      "RealtimeData": "realtime.data.queue",
      "PersistData": "persist.data.queue",
      "OpcData": "opc.data.queue",
      "Alarm": "alarm.queue",
      "DeviceStatus": "device.status.queue"
    },

    "RoutingKeys": {
      "RealtimeData": "data.realtime",
      "HistoricalData": "data.historical",
      "Alarm": "alarm.#",
      "DeviceStatus": "device.status",
      "OpcData": "opc.data"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Monitor.MessageService": "Debug",
      "Microsoft": "Warning"
    }
  }
}
